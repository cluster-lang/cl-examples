// ==============================================================================
// Cluster Printing Primer for Beginners:
// ------------------------------------------------------------------------------
// 1. pln("...")     -> Modern 3-letter shorthand for printing with an automatic newline.
// 2. println("...") -> Classic standard printing with a newline (like Go, Java, Rust).
// 3. put "..."      -> Direct statement keyword to output text (clean syntax, no parens).
// ==============================================================================

fn main() -> int:
    // Beginners can use 'pln' for quick and clean printing:
    pln("this is cluster print to screen example")

    // Note: You can also use 'println' interchangeably:
    // println("this is cluster print to screen example")

    // Or the statement form 'put':
    // put "this is cluster print to screen example"

    return 0
