// ==============================================================================
// Topic: C++ Strings Introduction (W3Schools cpp_strings.asp Example 1)
// C++ Equivalent:
//   string greeting = "Hello";
//   cout << greeting;
// ------------------------------------------------------------------------------
// Cluster Printing Primer for Beginners:
//   1. pln("...")     -> Modern shorthand for printing with automatic newline.
//   2. println("...") -> Standard print with automatic newline.
//   3. put "..."      -> Statement keyword for direct output.
// ==============================================================================

fn main() -> int:
    // In Cluster, variables are declared cleanly with ':=':
    greeting := "Hello"

    // Print the string using modern 'pln':
    pln(greeting)

    // Note: You can also use 'println' or 'put':
    // println(greeting)
    // put greeting

    return 0
