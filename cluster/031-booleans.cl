// ==============================================================================
// Topic: C++ Booleans - Boolean Values (W3Schools cpp_booleans.asp Example 1)
// C++ Equivalent:
//   bool isCodingFun = true;
//   bool isFishTasty = false;
//   cout << isCodingFun << "\n";
//   cout << isFishTasty;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Cluster supports boolean literals 'true' and 'false'.
//   Printing them outputs 1 (for true) and 0 (for false).
// ==============================================================================

fn main() -> int:
    isCodingFun := true
    isFishTasty := false

    pln(isCodingFun)
    pln(isFishTasty)
    return 0
