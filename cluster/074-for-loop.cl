// Topic: C++ For Loop (W3Schools cpp_for_loop.asp Example 1)
// C++ Equivalent:
//   for (int i = 0; i < 5; i++) {
//     cout << i << "\n";
//   }
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Use 'for i in range(5):' to loop cleanly through a range from 0 to 4.
// ==============================================================================

fn main() -> int:
    for i in range(5):
        pln(i)

    return 0
