// Topic: Escape Characters - Single Quote (W3Schools cpp_strings_esc.asp Example 2)
// C++ Equivalent:
//   string txt = "It's alright.";
//   cout << txt;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Single quotes can be written directly or escaped with \'.
// ==============================================================================

fn main() -> int:
    txt := "It's alright."
    pln(txt)
    return 0
