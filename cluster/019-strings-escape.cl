// ==============================================================================
// Topic: Escape Characters - Horizontal Tab (W3Schools cpp_strings_esc.asp Example 5)
// C++ Equivalent:
//   string txt = "Hello\tWorld!";
//   cout << txt;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   \t inserts a horizontal tab space.
// ==============================================================================

fn main() -> int:
    txt := "Hello\tWorld!"
    pln(txt)
    return 0
