// ==============================================================================
// Topic: C++ Strings Introduction (W3Schools cpp_strings.asp Example 2)
// C++ Equivalent:
//   string greeting = "Hello and welcome!";
//   cout << greeting;
// ------------------------------------------------------------------------------
// Cluster Printing Primer:
//   pln("...") / println("...") / put "..."
// ==============================================================================

fn main() -> int:
    // Declare a longer greeting text:
    greeting := "Hello and welcome!"

    // Output to screen:
    pln(greeting)

    // Beginners can also write:
    // println(greeting)

    return 0


