// ==============================================================================
// Topic: Boolean Expressions - Comparison (W3Schools cpp_booleans_expressions.asp Example 1)
// C++ Equivalent:
//   int x = 10;
//   int y = 9;
//   cout << (x > y);
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Comparison operators (> , < , >= , <= , == , !=) return boolean truth values.
// ==============================================================================

fn main() -> int:
    x := 10
    y := 9

    // Evaluates to 1 (true) because 10 is greater than 9:
    pln(x > y)
    return 0
