// ==============================================================================
// Topic: C++ Conditions - if with Variables (W3Schools cpp_conditions.asp Example 2)
// C++ Equivalent:
//   int x = 20;
//   int y = 18;
//   if (x > y) {
//     cout << "x is greater than y";
//   }
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Variables are compared cleanly inside the 'if' condition.
// ==============================================================================

fn main() -> int:
    x := 20
    y := 18

    if x > y:
        pln("x is greater than y")

    return 0
