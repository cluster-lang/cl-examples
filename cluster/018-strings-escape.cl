// ==============================================================================
// Topic: Escape Characters - Newline (W3Schools cpp_strings_esc.asp Example 4)
// C++ Equivalent:
//   string txt = "Hello\nWorld!";
//   cout << txt;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   \n inserts an explicit newline into a string.
// ==============================================================================

fn main() -> int:
    txt := "Hello\nWorld!"
    pln(txt)
    return 0
