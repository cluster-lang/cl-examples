// ==============================================================================
// Topic: Strings vs C-Style Character Arrays (W3Schools cpp_strings_cstyle.asp Example 1)
// C++ Equivalent:
//   string greeting1 = "Hello";
//   char greeting2[] = "Hello";
//   cout << greeting1 << "\n";
//   cout << greeting2;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Cluster strings are high-performance UTF-8 strings.
// ==============================================================================

fn main() -> int:
    greeting1 := "Hello"
    greeting2 := "Hello"

    pln(greeting1)
    pln(greeting2)
    return 0
