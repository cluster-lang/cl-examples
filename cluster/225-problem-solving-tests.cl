// ==============================================================================
// 225. Simple Parity Test
// Source: https://www.w3schools.com/cpp/cpp_problem_solving_tests.asp
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Parity conditional check.
// ==============================================================================

fn main() -> int:
    n := 7
    if n % 2 == 0:
        pln("Even")
    else:
        pln("Odd")
    return 0
