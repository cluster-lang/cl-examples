// ==============================================================================
// Topic: Boolean Expressions - Equality Comparison (W3Schools cpp_booleans_expressions.asp Example 3)
// C++ Equivalent:
//   int x = 10;
//   cout << (x == 10);
// ------------------------------------------------------------------------------
// Cluster Primer:
//   The '==' operator checks if two values are equal.
// ==============================================================================

fn main() -> int:
    x := 10

    // Evaluates to 1 (true) because x equals 10:
    pln(x == 10)
    return 0
