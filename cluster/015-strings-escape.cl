// ==============================================================================
// Topic: Escape Characters - Double Quotes (W3Schools cpp_strings_esc.asp Example 1)
// C++ Equivalent:
//   string txt = "We are the so-called \"Vikings\" from the north.";
//   cout << txt;
// ------------------------------------------------------------------------------
// Cluster Primer:
//   The backslash escape \" allows including double quotes inside strings.
// ==============================================================================

fn main() -> int:
    txt := "We are indian \"Muslims\""
    pln(txt)
    return 0
