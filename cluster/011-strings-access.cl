// ==============================================================================
// Topic: Accessing Second Character (W3Schools cpp_strings_access.asp Example 2)
// C++ Equivalent:
//   string myString = "Hello";
//   cout << myString[1];
// ------------------------------------------------------------------------------
// Cluster Primer:
//   Index 1 refers to the second element in the string.
// ==============================================================================

fn main() -> int:
    myString := "Hello"

    // Access second character ('e'):
    pln(myString[1])
    return 0
