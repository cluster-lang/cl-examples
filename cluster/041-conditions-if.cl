// ==============================================================================
// Topic: C++ Conditions - The if Statement (W3Schools cpp_conditions.asp Example 1)
// C++ Equivalent:
//   if (20 > 18) {
//     cout << "20 is greater than 18";
//   }
// ------------------------------------------------------------------------------
// Cluster Primer:
//   In Cluster, the 'if' condition ends with a colon ':' and executes
//   the indented block when true. No parentheses required!
// ==============================================================================

fn main() -> int:
    if 20 > 18:
        pln("20 is greater than 18")

    return 0
